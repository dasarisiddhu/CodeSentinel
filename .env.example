# ─────────────────────────────────────────────────────────────────────────────
# CodeSentinel — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Groq LLM ─────────────────────────────────────────────────────────────────
# Get yours at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Primary model (Llama 3.3 70B) — fast, high quality
GROQ_MODEL_PRIMARY=llama-3.3-70b-versatile

# Fallback model (Llama 3.1 8B) — used if primary times out or errors
GROQ_MODEL_FALLBACK=llama-3.1-8b-instant

# Groq API call timeout in seconds
LLM_TIMEOUT=20

# ── GitHub PR Delivery ────────────────────────────────────────────────────────
# Leave blank to use mock PR mode (identical response shape, mocked: true)
GITHUB_TOKEN=
GITHUB_REPO=owner/repo-name

# GitHub API call timeout in seconds
GITHUB_TIMEOUT=10

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite path — relative to backend/ dir. Change to postgres+asyncpg://... later.
DATABASE_URL=sqlite+aiosqlite:///./codesentinel.db

# ── Cache ─────────────────────────────────────────────────────────────────────
# Maximum number of completed reviews kept in the in-memory LRU demo cache
CACHE_MAX_SIZE=10

# ── Logging ───────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated origins for the frontend dev server
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
