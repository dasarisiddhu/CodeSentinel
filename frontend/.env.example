# ── CodeSentinel Frontend Environment Variables ──────────────────────────────
# In local development:
NEXT_PUBLIC_API_URL=http://localhost:8000

# In production (e.g. Vercel deployment):
# Set NEXT_PUBLIC_API_URL in your Vercel Project Settings to your deployed backend URL:
# NEXT_PUBLIC_API_URL=https://your-codesentinel-backend.onrender.com
